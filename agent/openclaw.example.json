{
  "agents": {
    "defaults": {
      "workspace": "/home/azureuser/ai-newsroom/agent",
      "model": "ollama/llama3.2:1b"
    }
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "https://ollama.com",
        "apiKey": "your-ollama-cloud-api-key",
        "models": [
          {
            "id": "llama3.2:1b",
            "name": "Llama 3.2 1B"
          }
        ]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "your-telegram-bot-token",
      "dmPolicy": "pairing"
    }
  },
  "gateway": {
    "mode": "local"
  }
}
